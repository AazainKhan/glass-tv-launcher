diff --git a/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt b/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt
new file mode 100644
index 0000000..74aff98
--- /dev/null
+++ b/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt
@@ -0,0 +1,73 @@
+package com.phairplay.service
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import com.phairplay.settings.SettingsRepository
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/**
+ * ControlReceiver — lets a trusted app (a launcher's AirPlay toggle) turn the receiver on and off
+ * and ask whether it's running, without opening PhairPlay.
+ *
+ * Exported, but guarded by [PERMISSION_CONTROL] (signature level): only apps signed with the same
+ * key can send to it. Replies and state changes go out as [ACTION_STATE] broadcasts that need the
+ * same permission to receive.
+ *
+ * Turning the receiver on also turns "Start on boot" on, so the toggle survives a restart; turning
+ * it off turns that off again.
+ */
+class ControlReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val app = context.applicationContext
+        when (intent.action) {
+            ACTION_ENABLE -> {
+                ServiceController.start(app)
+                rememberOnBoot(app, true)
+            }
+            ACTION_DISABLE -> {
+                if (PhairPlayService.running) ServiceController.stop(app)
+                rememberOnBoot(app, false)
+                broadcastState(app, running = false, sender = null)
+            }
+            ACTION_QUERY -> broadcastState(app, PhairPlayService.running, PhairPlayService.senderName)
+        }
+    }
+
+    private fun rememberOnBoot(context: Context, on: Boolean) {
+        val pending = goAsync()
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                SettingsRepository(context).update { it.copy(startOnBoot = on) }
+            } catch (e: Exception) {
+                Timber.e(e, "ControlReceiver: couldn't save startOnBoot")
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    companion object {
+        const val PERMISSION_CONTROL = "com.phairplay.permission.CONTROL"
+        const val ACTION_ENABLE = "com.phairplay.action.ENABLE"
+        const val ACTION_DISABLE = "com.phairplay.action.DISABLE"
+        const val ACTION_QUERY = "com.phairplay.action.QUERY"
+        const val ACTION_STATE = "com.phairplay.action.STATE"
+        const val EXTRA_RUNNING = "running"
+        const val EXTRA_SENDER = "sender"
+
+        fun broadcastState(context: Context, running: Boolean, sender: String?) {
+            context.sendBroadcast(
+                Intent(ACTION_STATE)
+                    .putExtra(EXTRA_RUNNING, running)
+                    .putExtra(EXTRA_SENDER, sender)
+                    .addFlags(Intent.FLAG_RECEIVER_FOREGROUND),
+                PERMISSION_CONTROL,
+            )
+        }
+    }
+}
