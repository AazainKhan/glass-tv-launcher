diff --git a/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt b/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt
new file mode 100644
index 0000000..e10dd2b
--- /dev/null
+++ b/app/src/main/kotlin/com/phairplay/service/ControlReceiver.kt
@@ -0,0 +1,284 @@
+package com.phairplay.service
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.SystemClock
+import com.phairplay.airplay.DacpClient
+import com.phairplay.settings.AppSettings
+import com.phairplay.settings.SettingsRepository
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/**
+ * ControlReceiver — control protocol v2 for a trusted app (the Glass launcher): turn the receiver
+ * on and off, change settings, send transport commands, and read state, without opening PhairPlay.
+ *
+ * Commands in: ENABLE, DISABLE, QUERY, SET (extras `key` + one of `bool` / `int` / `string`),
+ * TRANSPORT (extra `command`: play / pause / stop).
+ * Events out: STATE (`protocol`, `running`, `sender`, every setting by its key), SESSION, PAIRING_CODE,
+ * NOW_PLAYING, ERROR (`code`, `action`, and `key` or `command`).
+ *
+ * Exported, but guarded by [PERMISSION_CONTROL] (signature level): only apps signed with the same
+ * key can send to it, and every event is sent with the same permission so only they can read it.
+ *
+ * Turning the receiver on also turns "Start on boot" on, so the toggle survives a restart; turning
+ * it off turns that off again.
+ */
+class ControlReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val app = context.applicationContext
+        when (intent.action) {
+            ACTION_ENABLE -> {
+                ServiceController.start(app)
+                rememberOnBoot(app, true)
+            }
+            ACTION_DISABLE -> {
+                if (PhairPlayService.running) ServiceController.stop(app)
+                rememberOnBoot(app, false)
+                broadcastState(app, running = false, sender = null)
+            }
+            ACTION_QUERY -> {
+                broadcastState(app, PhairPlayService.running, PhairPlayService.senderName)
+                replay(app)
+            }
+            ACTION_SET -> handleSet(app, intent)
+            ACTION_TRANSPORT -> handleTransport(app, intent)
+        }
+    }
+
+    private fun handleSet(app: Context, intent: Intent) {
+        val key = intent.getStringExtra(EXTRA_KEY)
+        val setting = settings.firstOrNull { it.key == key }
+        if (setting == null) {
+            broadcastError(app, ACTION_SET, ERR_UNKNOWN_KEY, EXTRA_KEY, key)
+            return
+        }
+        val update = setting.read(intent)
+        if (update == null) {
+            broadcastError(app, ACTION_SET, ERR_BAD_VALUE, EXTRA_KEY, key)
+            return
+        }
+        val pending = goAsync()
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                val repo = SettingsRepository(app)
+                val before = repo.settingsFlow.first()
+                // An unchanged value must not restart the receiver, which would end a live session.
+                if (update(before) != before) {
+                    repo.update(update)
+                    // Receivers read settings once at start, so a running one restarts to apply them.
+                    if (setting.needsRestart && PhairPlayService.running) ServiceController.restart(app)
+                }
+                broadcastState(app, PhairPlayService.running, PhairPlayService.senderName)
+            } catch (e: Exception) {
+                Timber.e(e, "ControlReceiver: couldn't save $key")
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    private fun handleTransport(app: Context, intent: Intent) {
+        val command = intent.getStringExtra(EXTRA_COMMAND)
+        val dacp = when (command) {
+            "play" -> DacpClient.CMD_PLAY
+            "pause" -> DacpClient.CMD_PAUSE
+            "stop" -> DacpClient.CMD_STOP
+            else -> null
+        }
+        if (dacp == null) {
+            broadcastError(app, ACTION_TRANSPORT, ERR_BAD_COMMAND, EXTRA_COMMAND, command)
+            return
+        }
+        // The DACP call may touch the network, so it stays off the main thread; a failure must not kill the app.
+        val pending = goAsync()
+        CoroutineScope(Dispatchers.IO).launch {
+            try { PhairPlayService.transport(dacp) } catch (e: Exception) {
+                Timber.e(e, "ControlReceiver: transport $command failed")
+            } finally { pending.finish() }
+        }
+    }
+
+    private fun rememberOnBoot(context: Context, on: Boolean) {
+        val pending = goAsync()
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                SettingsRepository(context).update { it.copy(startOnBoot = on) }
+            } catch (e: Exception) {
+                Timber.e(e, "ControlReceiver: couldn't save startOnBoot")
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    /** One settable PhairPlay setting: its wire key, how to read it from a SET intent, and its effect. */
+    private class Setting(
+        val key: String,
+        val needsRestart: Boolean,
+        val read: (Intent) -> ((AppSettings) -> AppSettings)?,
+        val value: (AppSettings) -> Any,
+    )
+
+    companion object {
+        const val PERMISSION_CONTROL = "com.phairplay.permission.CONTROL"
+        const val PROTOCOL_VERSION = 2
+        const val PAIRING_TTL_MS = 120_000L
+
+        const val ACTION_ENABLE = "com.phairplay.action.ENABLE"
+        const val ACTION_DISABLE = "com.phairplay.action.DISABLE"
+        const val ACTION_QUERY = "com.phairplay.action.QUERY"
+        const val ACTION_SET = "com.phairplay.action.SET"
+        const val ACTION_TRANSPORT = "com.phairplay.action.TRANSPORT"
+        const val ACTION_STATE = "com.phairplay.action.STATE"
+        const val ACTION_SESSION = "com.phairplay.action.SESSION"
+        const val ACTION_PAIRING_CODE = "com.phairplay.action.PAIRING_CODE"
+        const val ACTION_NOW_PLAYING = "com.phairplay.action.NOW_PLAYING"
+        const val ACTION_ERROR = "com.phairplay.action.ERROR"
+
+        const val EXTRA_RUNNING = "running"
+        const val EXTRA_SENDER = "sender"
+        const val EXTRA_PROTOCOL = "protocol"
+        const val EXTRA_KEY = "key"
+        const val EXTRA_BOOL = "bool"
+        const val EXTRA_INT = "int"
+        const val EXTRA_STRING = "string"
+        const val EXTRA_COMMAND = "command"
+
+        const val ERR_UNKNOWN_KEY = "unknown_key"
+        const val ERR_BAD_VALUE = "bad_value"
+        const val ERR_BAD_COMMAND = "bad_command"
+
+        private fun bool(key: String, restart: Boolean, get: (AppSettings) -> Boolean, set: (AppSettings, Boolean) -> AppSettings) =
+            Setting(
+                key, restart,
+                read = { i ->
+                    val b = i.getBooleanExtra(EXTRA_BOOL, false)
+                    val update: (AppSettings) -> AppSettings = { v -> set(v, b) }
+                    update.takeIf { i.hasExtra(EXTRA_BOOL) }
+                },
+                value = get,
+            )
+
+        private val settings = listOf(
+            Setting(
+                "display_name", true,
+                read = { i ->
+                    val name = i.getStringExtra(EXTRA_STRING)?.trim().orEmpty()
+                    val update: (AppSettings) -> AppSettings = { v -> v.copy(displayName = name) }
+                    update.takeIf { i.hasExtra(EXTRA_STRING) && name.length <= AppSettings.DISPLAY_NAME_MAX_LENGTH }
+                },
+                value = { it.displayName },
+            ),
+            bool("airplay_enabled", true, { it.airPlayEnabled }) { s, b -> s.copy(airPlayEnabled = b) },
+            bool("miracast_enabled", true, { it.miracastEnabled }) { s, b -> s.copy(miracastEnabled = b) },
+            bool("cast_enabled", true, { it.castEnabled }) { s, b -> s.copy(castEnabled = b) },
+            bool("pin_auth", true, { it.airPlayPinAuthEnabled }) { s, b -> s.copy(airPlayPinAuthEnabled = b) },
+            bool("start_on_boot", false, { it.startOnBoot }) { s, b -> s.copy(startOnBoot = b) },
+            bool("debug_overlay", true, { it.showDebugOverlay }) { s, b -> s.copy(showDebugOverlay = b) },
+            bool("high_resolution", true, { it.forceHighResolution }) { s, b -> s.copy(forceHighResolution = b) },
+            bool("mirror_audio", true, { it.mirrorAudioEnabled }) { s, b -> s.copy(mirrorAudioEnabled = b) },
+        )
+
+        // One consumer runs queued jobs strictly in order, even ones that suspend (STATE reads settings),
+        // so no event can overtake another.
+        private val queue = Channel<suspend () -> Unit>(Channel.UNLIMITED)
+        private val events = CoroutineScope(Dispatchers.IO).also { scope ->
+            scope.launch { for (job in queue) runCatching { job() }.onFailure { Timber.e(it, "ControlReceiver: event failed") } }
+        }
+
+        // Every event goes through the one `events` queue so none can overtake another.
+        private fun send(context: Context, intent: Intent) {
+            val app = context.applicationContext
+            queue.trySend { sendNow(app, intent) }
+        }
+
+        private fun sendNow(context: Context, intent: Intent) {
+            context.sendBroadcast(intent.addFlags(Intent.FLAG_RECEIVER_FOREGROUND), PERMISSION_CONTROL)
+        }
+
+        // Last session, pairing code and now-playing, replayed on QUERY so a launcher that restarted
+        // mid-pairing gets the code back. Cleared when the matching "ended"/"dismissed" goes out.
+        private val replayLock = Any()
+        private var lastSession: Intent? = null
+        private var lastPairing: Intent? = null
+        private var pairingExpiresAt = 0L
+        private var lastNowPlaying: Intent? = null
+
+        /** The receiver stopped: nothing is in progress any more, so nothing is replayed. */
+        fun clearReplay() = synchronized(replayLock) { lastSession = null; lastPairing = null; lastNowPlaying = null }
+
+        private fun replay(context: Context) {
+            val (session, pairing, np) = synchronized(replayLock) {
+                val left = pairingExpiresAt - SystemClock.elapsedRealtime()
+                Triple(lastSession, lastPairing?.takeIf { left > 0 }?.let { Intent(it).putExtra("ttl_ms", left) }, lastNowPlaying)
+            }
+            listOfNotNull(session, pairing, np).forEach { send(context, Intent(it)) }
+        }
+
+        /** Sends STATE with the protocol version and every setting's current value. */
+        fun broadcastState(context: Context, running: Boolean, sender: String?) {
+            val app = context.applicationContext
+            queue.trySend {
+                val s = runCatching { SettingsRepository(app).settingsFlow.first() }.getOrDefault(AppSettings.DEFAULT)
+                val intent = Intent(ACTION_STATE)
+                    .putExtra(EXTRA_PROTOCOL, PROTOCOL_VERSION)
+                    .putExtra(EXTRA_RUNNING, running)
+                    .putExtra(EXTRA_SENDER, sender)
+                    .putExtra("display_name_max", AppSettings.DISPLAY_NAME_MAX_LENGTH)
+                for (setting in settings) when (val v = setting.value(s)) {
+                    is Boolean -> intent.putExtra(setting.key, v)
+                    is String -> intent.putExtra(setting.key, v)
+                }
+                sendNow(app, intent)
+            }
+        }
+
+        /** [kind] is mirror, video, audio, photo or unknown; a later `started` refines the kind. */
+        fun broadcastSession(context: Context, started: Boolean, sender: String?, kind: String) {
+            val i = Intent(ACTION_SESSION)
+                .putExtra("state", if (started) "started" else "ended")
+                .putExtra(EXTRA_SENDER, sender)
+                .putExtra("kind", kind)
+            synchronized(replayLock) { lastSession = if (started) Intent(i) else null }
+            send(context, i)
+        }
+
+        /** [code] null means dismissed; `ttl_ms` lets the launcher drop a card whose close event is lost. */
+        fun broadcastPairingCode(context: Context, code: String?) {
+            val i = Intent(ACTION_PAIRING_CODE).putExtra("shown", code != null).putExtra("code", code).putExtra("ttl_ms", PAIRING_TTL_MS)
+            synchronized(replayLock) {
+                lastPairing = if (code != null) Intent(i) else null
+                pairingExpiresAt = SystemClock.elapsedRealtime() + PAIRING_TTL_MS
+            }
+            send(context, i)
+        }
+
+        /** Position, duration and artwork are not known to the receiver: -1 and false. */
+        fun broadcastNowPlaying(context: Context, title: String?, artist: String?, album: String?, hasArtwork: Boolean, active: Boolean) {
+            val i = Intent(ACTION_NOW_PLAYING)
+                .putExtra("active", active)
+                .putExtra("playing", active)
+                .putExtra("title", title)
+                .putExtra("artist", artist)
+                .putExtra("album", album)
+                .putExtra("has_artwork", hasArtwork)
+                .putExtra("position_ms", -1L)
+                .putExtra("duration_ms", -1L)
+            synchronized(replayLock) { lastNowPlaying = if (active) Intent(i) else null }
+            send(context, i)
+        }
+
+        private fun broadcastError(context: Context, action: String, code: String, extraName: String, extra: String?) =
+            send(context, Intent(ACTION_ERROR)
+                .putExtra("action", action)
+                .putExtra("code", code)
+                .putExtra(extraName, extra))
+    }
+}
