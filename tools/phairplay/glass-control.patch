+
+    /** Publishes the receiver state to trusted apps (a launcher's AirPlay toggle). */
+    private fun publishState(isRunning: Boolean, sender: String?) {
+        if (running == isRunning && senderName == sender) return
+        running = isRunning
+        senderName = sender
+        ControlReceiver.broadcastState(applicationContext, isRunning, sender)
+    }
+
+    /**
+     * Something arrived for the screen (a mirror, a photo, music, a pairing PIN) while the player
+     * isn't in front: bring it forward, flagged so it steps back again when the session ends.
+     */
+    private fun bringPlayerForward() {
+        if (MainActivity.visible) return
+        runCatching {
+            startActivity(
+                Intent(this, MainActivity::class.java)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT)
+                    .putExtra(MainActivity.EXTRA_SESSION, true)
+            )
+        }.onFailure { Logger.e("Couldn't bring the player forward", it) }
     }
