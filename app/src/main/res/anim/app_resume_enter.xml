<?xml version="1.0" encoding="utf-8"?>
<!--
  Resuming an app's existing task (P302): Fire OS/Android's default here is ActivityOptions' scale-up "genie", which is
  what read as a stutter followed by a snap. A short fade matches the path a fresh launch already takes (app_open_enter),
  so both ways in look the same.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="140"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:toAlpha="1" />
