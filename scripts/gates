#!/usr/bin/env bash
# The merge gates: JVM tests and lint. On success it stamps the exact tree it checked, so the pre-push
# hook doesn't run them again for that tree. Push with: scripts/gates && git push …
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "gates: uncommitted changes; commit first so the stamp matches what is pushed" >&2; exit 1; }
./gradlew -q :app:testDebugUnitTest :app:lintDebug
git rev-parse 'HEAD^{tree}' > "$(git rev-parse --git-dir)/gates-ok"
echo "gates: passed for $(git rev-parse --short HEAD)"
