#!/usr/bin/env bash
# Captures the Baseline Profile on the stick without androidx.benchmark, whose root check (`su root id`)
# hangs under Magisk. Same idea as BaselineProfileRule below API 33: reset the app's profile, drive the
# everyday Home journey with real remote presses, flush the JIT profile, and dump it with profman as root.
# Writes app/src/release/generated/baselineProfiles/baseline-prof.txt (picked up by release builds).
#   scripts/profile-capture [rounds]     (default 3 rounds of the journey)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/lib/device.sh"; require_device_access
PKG=dev.glasslauncher
ROUNDS="${1:-3}"
OUT="$ROOT/app/src/release/generated/baselineProfiles/baseline-prof.txt"
key() { "$ROOT/scripts/key" "$@" >/dev/null; }
home() { adb shell am start -W -a android.intent.action.MAIN -c android.intent.category.HOME -n "$PKG/.MainActivity" >/dev/null; }

adb shell "su -c 'cmd package compile --reset $PKG'" >/dev/null
# Empty the profile rather than delete it: ART only writes to a profile file that already exists
# (installd makes it at install time), so a deleted one stays missing until the next reinstall.
UID_="$(adb shell dumpsys package "$PKG" | sed -n 's/.*userId=\([0-9]*\).*/\1/p' | head -1 | tr -d '\r')"
CUR="/data/misc/profiles/cur/0/$PKG/primary.prof"
adb shell "su -c ': > $CUR && chown $UID_:$UID_ $CUR && chmod 600 $CUR'"
for r in $(seq "$ROUNDS"); do
  adb shell am force-stop "$PKG"; home; sleep 6           # cold start, first bake
  key right right right left left left                     # along the dock
  key down wait:400 down wait:400 right right left left     # into the grid
  key up wait:400 up wait:400 up wait:800                    # back up, then full screen
  key right wait:300 right wait:300 left wait:300 down wait:800
  key menu wait:700 down down back wait:500                 # app menu
  key down down down down select wait:900 back wait:700     # last row (Settings tile) open/close
  key up up up up wait:500
done
sleep 2
adb shell "su -c 'killall -s SIGUSR1 $PKG'"; sleep 3          # ART writes the JIT profile on SIGUSR1
APK="$(adb shell pm path "$PKG" | sed -n 's/^package://p' | head -1 | tr -d '\r')"
tmp="$(mktemp)"
adb shell "su -c 'profman --dump-classes-and-methods --profile-file=/data/misc/profiles/cur/0/$PKG/primary.prof --apk=$APK --dex-location=$APK'" | tr -d '\r' > "$tmp"
mkdir -p "$(dirname "$OUT")"
{ echo "# Captured on the stick by scripts/profile-capture ($ROUNDS rounds of the Home journey)."; grep -E '^[HSP]*L[^ ]+;' "$tmp" | sort -u; } > "$OUT"
rm -f "$tmp"
echo "$(grep -c '^[HSP]*L' "$OUT") rules -> ${OUT#$ROOT/}"
