#!/usr/bin/env bash
# Fast remote presses: writes real key events to the Fire TV remote's input device (adb is root),
# so a press costs ~0.1 s instead of ~0.9 s for `input keyevent`, and holds auto-repeat
# exactly like a held button.
#
#   scripts/key down down right select     press in order (default 120 ms apart)
#   scripts/key hold:800:down               hold Down for 800 ms (auto-repeats)
#   scripts/key wait:500 back               pause 500 ms, then Back
#   KEY_GAP_MS=40 scripts/key down down     faster repeat-rate presses
#   scripts/key down settle                 then wait until the foreground app stops drawing
#   scripts/key settle:500                  (settle = 300 ms without a new frame; prints when the last
#                                           frame landed, or "busy" after 3 s of continuous drawing)
#
# Keys: up down left right select back home menu play rew ff
#       app1-app4 (the app buttons) recents settings alexa tv mute
set -euo pipefail
source "$(dirname "$0")/lib/device.sh"
require_device_access
DEV='$D'   # resolved on the device: the input node named "Fire TV Remote" (override with KEY_DEVICE)
GAP="${KEY_GAP_MS:-120}"

code() {
  case "$1" in
    up) echo 103 ;; down) echo 108 ;; left) echo 105 ;; right) echo 106 ;;
    select|ok|center|enter) echo '$S' ;; back) echo 158 ;; home) echo 172 ;; menu) echo 139 ;;
    play|playpause) echo 164 ;; rew) echo 168 ;; ff) echo 208 ;;
    app1) echo 744 ;; app2) echo 745 ;; app3) echo 746 ;; app4) echo 747 ;; recents) echo 748 ;;
    settings) echo 249 ;; alexa) echo 217 ;; tv) echo 362 ;; mute) echo 113 ;;
    *) echo "unknown key: $1" >&2; exit 2 ;;
  esac
}
keycode() {
  case "$1" in
    up) echo DPAD_UP ;; down) echo DPAD_DOWN ;; left) echo DPAD_LEFT ;; right) echo DPAD_RIGHT ;;
    select|ok|center|enter) echo DPAD_CENTER ;; back) echo BACK ;; home) echo HOME ;; menu) echo MENU ;;
    play|playpause) echo MEDIA_PLAY_PAUSE ;; rew) echo MEDIA_REWIND ;; ff) echo MEDIA_FAST_FORWARD ;;
    settings) echo SETTINGS ;; tv) echo LIVE_TV ;; mute) echo VOLUME_MUTE ;; *) echo "$1" | tr a-z A-Z ;;
  esac
}
ms() { awk "BEGIN{printf \"%.3f\", $1/1000}"; }

[ $# -gt 0 ] || { sed -n '2,11p' "$0"; exit 2; }
cmds=""; alt=""   # alt: the same sequence via `input keyevent`, for devices without the remote (emulator)
for arg in "$@"; do
  case "$arg" in
    wait:*) cmds+="sleep $(ms "${arg#wait:}");"; alt+="sleep $(ms "${arg#wait:}");" ;;
    settle|settle:*)
      q="${arg#settle}"; q="${q#:}"; q="${q:-300}"
      # Poll the foreground app's frame counter every 50 ms until it holds still for $q ms. Times are
      # centiseconds from /proc/uptime: the stick's shell does 32-bit arithmetic, so no ns clocks.
      # Something drawing every frame (video backdrop) never settles; give up after 3 s and say so.
      s="P=\$(dumpsys window 2>/dev/null | sed -n 's/.*mCurrentFocus=.* \([a-zA-Z0-9_.]*\)\/.*/\1/p' | head -1);"
      s+="cs(){ read u _ </proc/uptime; echo \${u%.*}\${u#*.}; };"
      s+="t0=\$(cs); last=-1; still=\$t0; r=settled;"
      s+="while :; do n=\$(dumpsys gfxinfo \$P | sed -n 's/.*Total frames rendered: //p'); now=\$(cs);"
      s+="[ \"\$n\" = \"\$last\" ] || { last=\$n; still=\$now; };"
      s+="[ \$(( (now-still)*10 )) -ge $q ] && break; [ \$(( (now-t0)*10 )) -ge 3000 ] && { r=busy; break; }; sleep 0.05; done;"
      s+="echo \$r \$(( (still-t0)*10 ))ms;"
      cmds+="$s"; alt+="$s" ;;
    hold:*:*)
      rest="${arg#hold:}"; c=$(code "${rest#*:}")
      cmds+="sendevent $DEV 1 $c 1;sendevent $DEV 0 0 0;sleep $(ms "${rest%%:*}");sendevent $DEV 1 $c 0;sendevent $DEV 0 0 0;sleep $(ms "$GAP");"
      alt+="input keyevent --longpress KEYCODE_$(keycode "${rest#*:}");" ;;
    *)
      c=$(code "$arg")
      cmds+="sendevent $DEV 1 $c 1;sendevent $DEV 0 0 0;sendevent $DEV 1 $c 0;sendevent $DEV 0 0 0;sleep $(ms "$GAP");"
      alt+="input keyevent KEYCODE_$(keycode "$arg");" ;;
  esac
done
find_dev="S=96; D=${KEY_DEVICE:-\$(getevent -pl 2>/dev/null | awk '/add device/{d=\$4} /name:.*Fire TV Remote/{print d; exit}')};"
# The Bluetooth remote's node disappears while the remote sleeps. Then use Amazon's virtual keyboard
# (amzkeyboard): still real key events, which Glass's tiles need (an injected `input keyevent` Select
# doesn't click them on Fire OS). Select is KEY_ENTER there. App and Settings buttons need the remote.
find_dev+="[ -n \"\$D\" ] || { D=\$(getevent -pl 2>/dev/null | awk '/add device/{d=\$4} /name:.*amzkeyboard/{print d; exit}'); S=28; };"
# Without either input node (emulators), fall back to `input keyevent` (~0.9 s a press).
adb shell "${find_dev}if [ -n \"\$D\" ]; then $cmds else $alt fi"
