#!/usr/bin/env bash
# Build, and with --device install on the connected TV. Usage: scripts/build [debug|release] [--device]
# Without --device it only builds (no adb at all). With it, the stick lock must be held by you (TV_OWNER) unless the
# device is an emulator; privapp-check and the install both write to the device.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEVICE=0; ARGS=()
for a in "$@"; do if [ "$a" = --device ]; then DEVICE=1; else ARGS+=("$a"); fi; done
VARIANT="${ARGS[0]:-release}"
if [ -z "${JAVA_HOME:-}" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -qE 'version "(17|21)'; then
  JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || /usr/libexec/java_home -v 17)"
  export JAVA_HOME
fi
cd "$ROOT"
case "$VARIANT" in
  debug) TASK=installDebug; ASSEMBLE=assembleDebug ;;
  release) TASK=installRelease; ASSEMBLE=assembleRelease ;;
  *) echo "usage: scripts/build [debug|release]" >&2; exit 2 ;;
esac
# Glass is a privileged system app on the stick (module glass-system), whose privapp allowlist is enforced at boot:
# an APK that requests a permission the module doesn't list bootloops Fire OS. Check (and extend) the allowlist
# before anything is installed.
./gradlew ":app:$ASSEMBLE" --console=plain -q
APK="$(ls -t app/build/outputs/apk/$VARIANT/*.apk 2>/dev/null | head -1)"
[ -n "$APK" ] || { echo "scripts/build: no $VARIANT APK found" >&2; exit 1; }
if [ "$DEVICE" != 1 ]; then echo "scripts/build: built $APK; pass --device to check the allowlist and install."; exit 0; fi
export GLASS_DEVICE=1
source "$ROOT/scripts/lib/device.sh"; require_device_write
scripts/privapp-check "$APK"
./gradlew ":app:$TASK" --console=plain -q
# Through the HOME intent, so it lands in the home task the Home button returns to (a plain start
# makes a second Glass in an ordinary task, and the first Home press then creates another).
adb shell am start -a android.intent.action.MAIN -c android.intent.category.HOME -n dev.glasslauncher/.MainActivity >/dev/null
# The accessibility service's capabilities can change with an update (P87): make sure it is back on, hands-free.
scripts/ensure-keys-service --toggle || echo "scripts/build: RemoteKeysService is not enabled; run scripts/ensure-keys-service" >&2
