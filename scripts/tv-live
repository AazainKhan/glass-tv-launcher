#!/usr/bin/env python3
"""Live view of the TV in a browser tab, with remote controls.

    scripts/tv-live [--port 8765] [--size 1920x1080] [--bitrate 20]

Defaults to the stick's native 1080p at 20 Mbit/s. "Lossless still" swaps in a PNG straight from the
framebuffer (no video compression) for judging edges and blending; "1:1" shows it unscaled.
/gallery shows what's being built, refreshing itself: Home screen renders and failing diffs, component
previews, motion strips and device clips, the focus graph, and open reports.
Open http://localhost:8765 (in the Claude desktop browser pane: preview "tv-live").
The device's screen recorder (H.264) is transcoded by ffmpeg to MJPEG, so any <img> can show it.
Arrow keys / Enter / Backspace (Back) / H (Home) / M (Menu) / Space (Play) drive the remote.
"Report" saves what you're looking at for the agents: a lossless still, the last ~6 s as video,
the focused element and your note, in reports/inbox/<time>-<note>/ (see scripts/reports).
App crashes and ANRs are reported there automatically (scripts/watch-crashes runs alongside).
Recording uses the stick's encoder, so close the tab before benchmarking.
"""
import argparse
import collections
import json
import os
import re
import sys
import tempfile
import shutil
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
KEY = os.path.join(ROOT, "scripts", "key")
REPORTS = os.path.join(ROOT, "reports", "inbox")
CLIP_SECONDS = 6
KEYS = {"up", "down", "left", "right", "select", "back", "home", "menu", "play", "rew", "ff"}



def default_serial():
    """Same rule as scripts/lib/device.sh: ANDROID_SERIAL, else the first non-emulator device."""
    if os.environ.get("ANDROID_SERIAL"):
        return
    rows = [l.split() for l in subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout.splitlines()[1:]]
    devices = [r[0] for r in rows if len(r) == 2 and r[1] == "device"]
    real = [d for d in devices if not d.startswith("emulator-")]
    if real or devices:
        os.environ["ANDROID_SERIAL"] = (real or devices)[0]

class Stream:
    """One shared device recording, started while at least one viewer is connected."""

    def __init__(self, size, bitrate):
        self.size, self.bitrate = size, bitrate
        self.frame, self.seq = None, 0
        self.recent = collections.deque()  # (monotonic time, jpeg) for the last CLIP_SECONDS
        self.cond = threading.Condition()
        self.viewers = 0
        self.thread = None

    def attach(self):
        with self.cond:
            self.viewers += 1
            if self.thread is None or not self.thread.is_alive():
                self.thread = threading.Thread(target=self._run, daemon=True)
                self.thread.start()

    def detach(self):
        with self.cond:
            self.viewers -= 1

    def publish(self, jpeg):
        now = time.monotonic()
        with self.cond:
            self.frame, self.seq = jpeg, self.seq + 1
            self.recent.append((now, jpeg))
            while self.recent and now - self.recent[0][0] > CLIP_SECONDS:
                self.recent.popleft()
            self.cond.notify_all()

    def next(self, after, timeout=5):
        with self.cond:
            self.cond.wait_for(lambda: self.seq != after, timeout)
            return self.frame, self.seq

    def _still(self):
        # screenrecord only emits frames when the screen changes, so seed viewers with a still.
        w = self.size.split("x")[0]
        cap = subprocess.run(
            f"adb exec-out screencap -p | ffmpeg -loglevel error -i - -vf scale={w}:-1 -q:v 2 -f mjpeg -",
            shell=True, capture_output=True)
        if cap.stdout:
            self.publish(cap.stdout)

    def _run(self):
        subprocess.run(["adb", "shell", "input keyevent KEYCODE_WAKEUP"], capture_output=True)
        self._still()
        while True:
            with self.cond:
                if self.viewers <= 0:
                    self.thread = None
                    return
            # screenrecord stops after 180 s; loop to keep the view going.
            rec = subprocess.Popen(
                ["adb", "exec-out", "screenrecord", "--output-format=h264", f"--size={self.size}",
                 f"--bit-rate={self.bitrate * 1_000_000}", "--time-limit=170", "-"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            ff = subprocess.Popen(
                ["ffmpeg", "-loglevel", "error", "-flags", "low_delay",
                 "-probesize", "65536", "-analyzeduration", "0", "-f", "h264", "-i", "-",
                 "-pix_fmt", "yuvj420p", "-q:v", "2", "-f", "mjpeg", "-"],
                stdin=rec.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            rec.stdout.close()
            buf = b""
            while True:
                chunk = ff.stdout.read1(65536)
                if not chunk:
                    break
                buf += chunk
                while True:
                    start = buf.find(b"\xff\xd8")
                    end = buf.find(b"\xff\xd9", start + 2)
                    if start < 0 or end < 0:
                        break
                    self.publish(buf[start:end + 2])
                    buf = buf[end + 2:]
                with self.cond:
                    if self.viewers <= 0:
                        break
            for p in (ff, rec):
                p.kill()
            subprocess.run(["adb", "shell", "pkill -INT screenrecord"], capture_output=True)
            time.sleep(0.2)


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()


def make_report(stream, note):
    """Saves what the viewer is looking at, plus context, for an agent to pick up."""
    slug = re.sub(r"[^a-z0-9]+", "-", note.lower()).strip("-")[:48] or "report"
    folder = os.path.join(REPORTS, time.strftime("%Y%m%d-%H%M%S") + "-" + slug)
    os.makedirs(folder)
    with open(os.path.join(folder, "still.png"), "wb") as f:
        f.write(subprocess.run(["adb", "exec-out", "screencap", "-p"], capture_output=True).stdout)
    with stream.cond:
        frames = list(stream.recent)
    if frames:
        # Re-time the buffered JPEGs with their real arrival gaps (the recorder is variable-rate).
        with tempfile.TemporaryDirectory() as tmp:
            lines = ["ffconcat version 1.0"]
            for i, (t, jpeg) in enumerate(frames):
                name = os.path.join(tmp, f"{i:04d}.jpg")
                with open(name, "wb") as f:
                    f.write(jpeg)
                # The recorder only emits changed frames: hold the last one until the report moment.
                nxt = frames[i + 1][0] if i + 1 < len(frames) else max(time.monotonic(), t + 1 / 30)
                lines += [f"file '{name}'", f"duration {max(nxt - t, 0.001):.4f}"]
            lst = os.path.join(tmp, "list.txt")
            with open(lst, "w") as f:
                f.write("\n".join(lines) + "\n")
            subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "concat", "-safe", "0", "-i", lst,
                            "-vf", "fps=30,format=yuv420p", "-c:v", "libx264", "-crf", "18",
                            os.path.join(folder, "last-6s.mp4")], capture_output=True)
    xml = sh("adb shell 'uiautomator dump /sdcard/report.xml >/dev/null 2>&1; cat /sdcard/report.xml'")
    node = re.search(r'<node[^>]*focused="true"[^>]*>', xml)
    focused = " ".join(f'{k}="{v}"' for k, v in re.findall(r'(resource-id|content-desc|text|bounds)="([^"]*)"', node.group(0)) if v) if node else ""
    context = {
        "note": note,
        "time": time.strftime("%Y-%m-%d %H:%M:%S"),
        "foreground": sh("adb shell dumpsys window | grep -m1 mCurrentFocus | sed 's/.* u0 //; s/}//'"),
        "focused": focused or "(none: nothing focused, or a non-accessible app)",
        "installed": sh("adb shell dumpsys package dev.glasslauncher | grep -m1 lastUpdateTime | sed 's/.*=//'"),
        "git": sh(f"git -C '{ROOT}' log -1 --format='%h %s'") + (" (+uncommitted changes)" if sh(f"git -C '{ROOT}' status --porcelain") else ""),
    }
    with open(os.path.join(folder, "report.md"), "w") as f:
        f.write(f"# {note or 'Report'}\n\n")
        for k, v in context.items():
            if k != "note":
                f.write(f"- **{k}:** {v}\n")
        f.write("\nFiles: `still.png` (lossless), `last-6s.mp4` (what was on screen before reporting).\n")
    return os.path.relpath(folder, ROOT)


GALLERY_SOURCES = {
    # section -> list of (glob relative to ROOT, kind)
    "Screens": [("app/build/outputs/roborazzi/*_compare.png", "diff"), ("app/src/test/screenshots/*.png", "image")],
    "Components": [("app/src/test/screenshots/previews/*.png", "image")],
    "Motion": [("app/build/strips/*.png", "image"), ("build/clips/*.png", "image"), ("build/clips/*.mp4", "video")],
    "Focus": [("app/build/focus-graph/*.md", "text")],
    "Reports": [("reports/inbox/*/still.png", "image"), ("reports/inbox/*/last-6s.mp4", "video"), ("reports/inbox/*/report.md", "text")],
}
SERVABLE = ("app/build/", "app/src/test/screenshots/", "build/clips/", "reports/")


def gallery_listing():
    import glob
    out = {}
    for section, sources in GALLERY_SOURCES.items():
        items = []
        for pattern, kind in sources:
            for f in glob.glob(os.path.join(ROOT, pattern)):
                rel = os.path.relpath(f, ROOT)
                item = {"path": rel, "kind": kind, "mtime": os.path.getmtime(f), "name": os.path.basename(f)}
                if section == "Reports":
                    item["name"] = os.path.basename(os.path.dirname(f)) + " · " + item["name"]
                if kind == "text":
                    with open(f, errors="replace") as fh:
                        item["text"] = fh.read()[:20000]
                items.append(item)
        out[section] = sorted(items, key=lambda i: -i["mtime"])
    return out


