def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=int(os.environ.get("PORT", 8765)))
    ap.add_argument("--size", default="1920x1080")
    ap.add_argument("--bitrate", type=int, default=20, help="Mbit/s")
    ap.add_argument("--no-watch", action="store_true", help="don't run scripts/watch-crashes alongside")
    args = ap.parse_args()
    default_serial()
    for tool in ("adb", "ffmpeg"):
        if not shutil.which(tool):
            raise SystemExit(f"tv-live needs {tool} on PATH")
    stream = Stream(args.size, args.bitrate)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            path = urlparse(self.path).path
            if path == "/":
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif path == "/stream":
                self.send_response(200)
                self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=frame")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                stream.attach()
                seq = -1
                try:
                    while True:
                        frame, seq = stream.next(seq)
                        if frame is None:
                            continue
                        self.wfile.write(b"--frame\r\nContent-Type: image/jpeg\r\nContent-Length: "
                                         + str(len(frame)).encode() + b"\r\n\r\n" + frame + b"\r\n")
                except (BrokenPipeError, ConnectionResetError):
                    pass
                finally:
                    stream.detach()
            elif path == "/gallery":
                body = GALLERY.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(body)
            elif path == "/api/gallery":
                body = json.dumps(gallery_listing()).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            elif path.startswith("/files/"):
                rel = os.path.normpath(path[len("/files/"):])
                full = os.path.realpath(os.path.join(ROOT, rel))
                if not full.startswith(os.path.realpath(ROOT) + os.sep) or not rel.startswith(SERVABLE) or not os.path.isfile(full):
                    self.send_error(404)
                    return
                ctype = {".png": "image/png", ".jpg": "image/jpeg", ".mp4": "video/mp4", ".md": "text/plain; charset=utf-8"}.get(
                    os.path.splitext(full)[1], "application/octet-stream")
                with open(full, "rb") as fh:
                    body = fh.read()
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "max-age=3600")
                self.end_headers()
                self.wfile.write(body)
            elif path == "/still.png":
                png = subprocess.run(["adb", "exec-out", "screencap", "-p"], capture_output=True).stdout
                self.send_response(200 if png else 503)
                self.send_header("Content-Type", "image/png")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(png)
            elif path == "/frame.jpg":
                frame = stream.frame or b""
                self.send_response(200 if frame else 503)
                self.send_header("Content-Type", "image/jpeg")
                self.end_headers()
                self.wfile.write(frame)
            else:
                self.send_error(404)

        def do_POST(self):
            u = urlparse(self.path)
            if u.path == "/report":
                body = self.rfile.read(int(self.headers.get("Content-Length", 0)) or 0)
                note = (json.loads(body or b"{}").get("note") or "").strip()
                out = json.dumps({"path": make_report(stream, note)}).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(out)
                return
            k = parse_qs(u.query).get("k", [""])[0]
            if u.path == "/key" and k in KEYS:
                # The human at the live view always gets through, even if an agent holds the lock.
                ok = subprocess.run([KEY, k], capture_output=True, env={**os.environ, "TV_FORCE": "1"}).returncode == 0
                self.send_response(204 if ok else 500)
                self.end_headers()
            else:
                self.send_error(400)

    if not args.no_watch:
        subprocess.Popen([os.path.join(ROOT, "scripts", "watch-crashes")], stdout=sys.stderr)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"tv-live on http://localhost:{args.port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
