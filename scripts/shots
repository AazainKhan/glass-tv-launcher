#!/usr/bin/env bash
# The JVM visual loop (Robolectric + Roborazzi). No device needed.
#   scripts/shots verify              compare every screen with its baseline (fails on change)
#   scripts/shots record              re-record baselines after an intended UI change
#   scripts/shots verify grid         one screen (test-name filter on HomeShots)
#   scripts/shots previews [record]  component @Previews (app/src/debug/.../preview/) vs their baselines
#   scripts/shots focus               crawl Home's focus graph -> app/build/focus-graph/home.md
#   scripts/shots strips [name|all]   frame strips of transitions -> app/build/strips/*.png
#   scripts/shots all                 verify + focus (what CI runs, via testDebugUnitTest)
# On failure, diffs are in app/build/outputs/roborazzi/*_compare.png.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
if [ -z "${JAVA_HOME:-}" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -qE 'version "(17|21)'; then
  JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || /usr/libexec/java_home -v 17)"; export JAVA_HOME
fi
cmd="${1:-verify}"; arg="${2:-}"
filter="*HomeShots${arg:+.$arg}*"
gradle() { ./gradlew --console=plain -q "$@" 2>&1 | grep -vE '^w: |^\[Incubating\]|warning-mode|deprecat|^$|Gradle 10|command_line_warnings' || true; }
report() {
  local res=app/build/test-results/testDebugUnitTest
  grep -ho 'testcase name="[^"]*" classname="[^"]*" time="[^"]*"' "$res"/*.xml 2>/dev/null | sed 's/testcase name="\([^"]*\)" classname="[^"]*\.\([^".]*\)" time="\([^"]*\)"/  \2.\1  \3s/'
  if grep -q "<failure" "$res"/*.xml 2>/dev/null; then
    echo "FAILED:"; grep -ho 'failure message="[^"]*' "$res"/*.xml | sed 's/failure message="/  /; s/&#10;/\n    /g; s/&gt;/>/g; s/&lt;/</g' | head -40
    return 1
  fi
}
case "$cmd" in
  verify) gradle :app:verifyRoborazziDebug --tests "$filter"; report ;;
  record) gradle :app:recordRoborazziDebug --tests "$filter"; report; echo "baselines: app/src/test/screenshots/" ;;
  previews)
    if [ "$arg" = record ]; then gradle :app:recordRoborazziDebug --tests '*Preview*'; else gradle :app:verifyRoborazziDebug --tests '*Preview*'; fi
    report; echo "baselines: app/src/test/screenshots/previews/" ;;
  focus)  gradle :app:testDebugUnitTest --tests '*FocusCrawlTest*'; report; echo "graph: app/build/focus-graph/home.md" ;;
  strips) gradle :app:testDebugUnitTest --tests '*MotionStrips*' -Pstrips="${arg:-all}"; report; ls app/build/strips/*.png ;;
  all)    gradle :app:verifyRoborazziDebug --tests '*HomeShots*' --tests '*FocusCrawlTest*' --tests '*Preview*'; report ;;
  *) sed -n '2,10p' "$0"; exit 2 ;;
esac
