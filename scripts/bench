#!/usr/bin/env bash
# Macrobenchmarks on the stick (baselineprofile/.../HomeBenchmarks.kt): one per perf budget scenario (startup
# cold/warm/hot, focus moves, row scroll, Control Center, app switcher, app menu, app launch), 10 iterations each,
# compiled as users get it (speed-profile). Prints a summary table; JSON + Perfetto traces land in build/bench/.
#   scripts/bench              the whole suite (~25 min)
#   scripts/bench <regex>      only matching tests (method names, e.g. startup, focus, controlCenter)
#   scripts/bench --no-build   reuse the last built APKs
#   scripts/bench profile      regenerate the Baseline Profile (app/src/release/generated/…)
# Needs Magisk root and the stick free. androidx.benchmark detects root with `su root id`, which Magisk's su
# reads as "open a root shell" (it waits on stdin forever). So the instrumentation runs as root (the session is
# rooted, no su needed) with an AOSP-style su shim first on its PATH for that one check.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/lib/device.sh"; require_device_access
hold_stick "$0" "$@"
cd "$ROOT"
if [ -z "${JAVA_HOME:-}" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -qE 'version "(17|21)'; then
  JAVA_HOME="$(/usr/libexec/java_home -v 21)"; export JAVA_HOME
fi
# Macrobenchmark force-stops the app every iteration, killing Glass's key-filtering accessibility
# service; while it's down the system can stall remote presses. Switch services off for the run.
a11y="$(adb shell settings get secure enabled_accessibility_services | tr -d '\r')"
# A run cut off between delete and restore (adb dropping) leaves "null"; never save that as the value to restore.
case "$a11y" in null|"") a11y=dev.glasslauncher/dev.glasslauncher.system.RemoteKeysService ;; esac
restore_a11y() { adb shell su -c "pm enable dev.glasslauncher/.widgets.NowPlayingService" >/dev/null 2>&1; [ "$a11y" = null ] || [ -z "$a11y" ] && return; adb shell settings put secure enabled_accessibility_services "$a11y"; adb shell settings put secure accessibility_enabled 1; }
trap restore_a11y EXIT
# macOS bash 3.2 skips the EXIT trap when the script is killed; turn signals into a normal exit.
trap "exit 130" INT TERM HUP
adb shell settings delete secure enabled_accessibility_services >/dev/null
if [ "${1:-}" = profile ]; then
  ./gradlew :app:generateBaselineProfile --console=plain -q
  find app/src -path '*generated/baselineProfiles*' -type f -exec wc -l {} +
  exit
fi
build=1; [ "${1:-}" = --no-build ] && { build=0; shift; }
[ "$build" = 1 ] && ./gradlew :app:assembleBenchmarkRelease :baselineprofile:assembleBenchmarkRelease --console=plain -q
adb install -r -d app/build/outputs/apk/benchmarkRelease/app-benchmarkRelease.apk >/dev/null
adb install -r -t baselineprofile/build/outputs/apk/benchmarkRelease/baselineprofile-benchmarkRelease.apk >/dev/null
scripts/key wait:1 >/dev/null 2>&1 || true   # pushes glass-press and its key layout
adb shell "su -c 'mkdir -p /data/local/tmp/benchbin && printf \"#!/system/bin/sh\n[ \\\"\\\$1\\\" = root ] && shift\nexec \\\"\\\$@\\\"\n\" > /data/local/tmp/benchbin/su && chmod 755 /data/local/tmp/benchbin/su'"
OUT=/sdcard/Android/media/dev.glasslauncher.baselineprofile
adb shell "rm -rf $OUT/*"
args="-e class dev.glasslauncher.baselineprofile.HomeBenchmarks"
[ -n "${1:-}" ] && args="-e tests_regex '.*${1}.*'"
adb shell "su -c \"PATH=/data/local/tmp/benchbin:\\\$PATH am instrument -w $args dev.glasslauncher.baselineprofile/androidx.test.runner.AndroidJUnitRunner\"" | grep -E "^(OK|FAILURES|Tests run|[0-9]+\)|java\.lang)" || true
rm -rf build/bench && mkdir -p build/bench && adb pull "$OUT/." build/bench >/dev/null
python3 - <<'PY'
import glob, json
for f in glob.glob("build/bench/*benchmarkData.json"):
    for b in json.load(open(f))["benchmarks"]:
        m = b["metrics"]
        parts = [f"{k}: median {v['median']:.1f}" for k, v in m.items()]
        if "sampledMetrics" in b:
            parts += [f"{k}: p50 {v['P50']:.1f} p90 {v['P90']:.1f} p99 {v['P99']:.1f}" for k, v in b["sampledMetrics"].items()]
        print(f"{b['name']:<28} " + " | ".join(parts))
PY
