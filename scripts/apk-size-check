#!/usr/bin/env bash
# Fails (exit 1) when the release APK is over perf-budget.json's apkMaxBytes. Run after :app:assembleRelease.
#   scripts/apk-size-check [apk]
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
apk="${1:-app/build/outputs/apk/release/app-release.apk}"
max="$(python3 -c 'import json; print(json.load(open("perf-budget.json"))["apkMaxBytes"])')"
size="$(wc -c < "$apk" | tr -d ' ')"
if [ "$size" -gt "$max" ]; then
  echo "apk-size: $size bytes is over the $max limit (+$((size - max))). Shrink it, or raise apkMaxBytes in perf-budget.json with the reason." >&2
  exit 1
fi
echo "apk-size: $size bytes (limit $max, $((max - size)) to spare)"
