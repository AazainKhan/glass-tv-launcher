<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No <permission> here: Glass defines BIND_ADDON; declaring it too would clash on install order. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_addon"
        android:label="Glass Sample Add-on">

        <service
            android:name=".SampleAddonService"
            android:exported="true"
            android:permission="dev.glasslauncher.permission.BIND_ADDON">
            <intent-filter>
                <action android:name="dev.glasslauncher.ADDON" />
            </intent-filter>
            <meta-data android:name="dev.glasslauncher.addon.api" android:value="1" />
            <meta-data android:name="dev.glasslauncher.addon.min_glass_api" android:value="1" />
            <meta-data android:name="dev.glasslauncher.addon.title" android:value="Sample Add-on" />
            <meta-data android:name="dev.glasslauncher.addon.icon" android:resource="@drawable/ic_addon" />
            <meta-data android:name="dev.glasslauncher.addon.needs_root" android:value="false" />
        </service>
    </application>
</manifest>
